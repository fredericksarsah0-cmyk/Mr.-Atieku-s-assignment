# ==============================================================================
# HOSPITAL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local with real secrets to GitHub!

# Database connection strings (Neon Hosted PostgreSQL)
# Pooled connection URL (used by Prisma Client in serverless runtime):
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection URL (used by Prisma CLI for migrations):
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cybersecurity & Authentication Keys
# Server-side pepper for Argon2id hashing (must be at least 32 characters of high entropy):
PASSWORD_PEPPER="replace-with-a-very-secure-random-server-pepper-minimum-32-chars"

# Secret key for encrypting/signing session tokens and cookies:
SESSION_SECRET="replace-with-a-random-64-char-string-for-session-management"

# Email Delivery for Mandatory 2FA OTP (Resend)
RESEND_API_KEY="re_sample_apiKey_here"
RESEND_FROM_EMAIL="Hospital Portal <onboarding@resend.dev>"

# Optional SMS Delivery for 2FA OTP (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
